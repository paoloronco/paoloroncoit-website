---
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID?.trim();
const microsoftClarityId = import.meta.env.PUBLIC_MICROSOFT_CLARITY_ID?.trim();

const googleAnalyticsEnabled = Boolean(googleAnalyticsId);
const microsoftClarityEnabled = Boolean(microsoftClarityId);
const analyticsEnabled = googleAnalyticsEnabled || microsoftClarityEnabled;
---

<script is:inline id="termly" src="https://app.termly.io/resource-blocker/8c058474-ccc0-4a3d-8d39-5cdebac8b508?autoBlock=on"></script>

<script is:inline data-categories="essential">
  // shortcut: preserve Termly's injected markup across Astro swaps; revisit if its root/style markers change.
  document.addEventListener('astro:before-swap', (event) => {
    const banner = document.getElementById('termly-code-snippet-support');
    if (banner) event.newDocument.body.prepend(banner);
    document.head.querySelectorAll('style').forEach((style) => {
      if (style.textContent.includes('termly-')) event.newDocument.head.appendChild(style);
    });
  });
</script>

{analyticsEnabled && (
  <script
    is:inline
    data-categories="essential"
    data-google-analytics-id={googleAnalyticsId}
    data-microsoft-clarity-id={microsoftClarityId}
  >
    (function () {
      var currentScript = document.currentScript;
      var googleAnalyticsId = currentScript ? currentScript.getAttribute('data-google-analytics-id') : '';
      var microsoftClarityId = currentScript ? currentScript.getAttribute('data-microsoft-clarity-id') : '';

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };

      function loadGoogleAnalytics() {
        if (!googleAnalyticsId || window.__paoloGoogleAnalyticsLoaded) return;
        window.__paoloGoogleAnalyticsLoaded = true;
        window.gtag('js', new Date());
        window.gtag('config', googleAnalyticsId);

        var script = document.createElement('script');
        script.setAttribute('data-categories', 'analytics');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(googleAnalyticsId);
        document.head.appendChild(script);
      }

      function loadMicrosoftClarity() {
        if (!microsoftClarityId || window.__paoloMicrosoftClarityLoaded) return;
        window.__paoloMicrosoftClarityLoaded = true;
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          t.setAttribute('data-categories', 'analytics');
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", microsoftClarityId);
      }

      function loadAnalytics() {
        loadGoogleAnalytics();
        loadMicrosoftClarity();
      }

      function handleConsent(data) {
        var state = (data && data.consentState) || window.Termly.getConsentState();
        var allowed = !!state && state.analytics === true;
        if (googleAnalyticsId) window['ga-disable-' + googleAnalyticsId] = !allowed;
        window.gtag('consent', 'update', {
          analytics_storage: allowed ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
        if (allowed) loadAnalytics();
        if (window.clarity) {
          window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: allowed ? 'granted' : 'denied' });
        }
        // Reload after withdrawal to stop already-running trackers as well as future loads.
        if (!allowed && (window.__paoloGoogleAnalyticsLoaded || window.__paoloMicrosoftClarityLoaded)) {
          window.location.reload();
        }
      }

      if (window.Termly) {
        window.Termly.on('initialized', handleConsent);
        window.Termly.on('consent', handleConsent);
        handleConsent();
      }
    })();
  </script>
)}
