---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props { category: CollectionEntry<'work'>['data']['category'] }
const { category } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const label = t(`work.category.${category}`);
---

<span
  class="inline-flex w-fit items-center gap-1.5 rounded-md border border-ink-500 bg-ink-700/70 px-2.5 py-1 text-xs font-medium leading-4 text-text-dim"
  aria-label={`${t('work.category')}: ${label}`}
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-muted" aria-hidden="true">
    <path d="m20 13-7 7a2 2 0 0 1-3 0l-7-7V3h10l7 7a2 2 0 0 1 0 3Z" />
    <circle cx="7.5" cy="7.5" r=".75" fill="currentColor" stroke="none" />
  </svg>
  {label}
</span>
