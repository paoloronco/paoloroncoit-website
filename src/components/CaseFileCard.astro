---
interface Props {
  href: string;
  title: string;
  summary: string;
  category: string;
  stack: string[];
  variant?: 'default' | 'hybrid';
}
const { href, title, summary, category, stack, variant = 'default' } = Astro.props;
---
<a
  href={href}
  class:list={[
    'readable-card',
    'group',
    'relative',
    'flex',
    'flex-col',
    'overflow-hidden',
    'rounded-card',
    'border',
    'border-ink-600',
    'bg-ink-800/75',
    'p-5',
    'shadow-2xl',
    'shadow-ink-900/25',
    'backdrop-blur-md',
    'transition-all',
    'hover:-translate-y-0.5',
    'hover:border-ink-500',
    'hover:bg-ink-800/95',
    variant === 'hybrid' ? 'casefile-card-hybrid' : '',
  ]}
>
  <span class="kicker self-start text-muted">{category}</span>

  <h3 class="readable-title mt-3 text-lg font-semibold text-text">{title}</h3>
  <p class="readable-summary mt-2 flex-1 text-sm leading-relaxed text-text-dim">{summary}</p>

  <div class="casefile-meta mt-4 flex flex-wrap items-center gap-1.5">
    {stack.map((s) => (
      <span class="rounded border border-ink-600 px-1.5 py-0.5 font-mono text-[10px] text-muted transition-colors group-hover:text-text-dim">{s}</span>
    ))}
    <span class="case-arrow ml-auto font-mono text-sm text-muted" aria-hidden="true">↗</span>
  </div>
</a>

<style>
  .casefile-card-hybrid {
    padding: 1.45rem;
    min-height: 255px;
    background: color-mix(in oklab, var(--color-ink-800) 85%, transparent);
    box-shadow: 0 18px 40px -34px color-mix(in oklab, var(--color-ink-900) 70%, black);
  }

  .casefile-card-hybrid:hover {
    background: color-mix(in oklab, var(--color-ink-800) 92%, transparent);
  }

  .casefile-card-hybrid .readable-title {
    font-size: 1.12rem;
    line-height: 1.38;
    margin-top: 0.9rem;
  }

  .casefile-card-hybrid .readable-summary {
    font-size: 0.94rem;
    line-height: 1.72;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 6.6rem;
  }

  .casefile-card-hybrid .casefile-meta {
    margin-top: auto;
  }
</style>
