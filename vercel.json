{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Content-Signal",
          "value": "search=yes, ai-input=yes, ai-train=no"
        },
        {
          "key": "Link",
          "value": "<https://paoloronco.it/sitemap-index.xml>; rel=\"sitemap\", <https://paoloronco.it/llms.txt>; rel=\"describedby\"; type=\"text/plain\", <https://paoloronco.it/.well-known/api-catalog>; rel=\"api-catalog\", <https://paoloronco.it/openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.oai.openapi+json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/category/:path*",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/en/category/:path*",
      "destination": "/en/writing",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/en/tag/:path*",
      "destination": "/en/writing",
      "permanent": true
    },
    {
      "source": "/author/:path*",
      "destination": "/writing",
      "permanent": true
    },
    {
      "source": "/en/author/:path*",
      "destination": "/en/writing",
      "permanent": true
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/en/portfolio/:path*",
      "destination": "/en/projects",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "/certificati/:path*",
      "permanent": true
    },
    {
      "source": "/en/docs",
      "destination": "/en/certifications",
      "permanent": true
    },
    {
      "source": "/en/docs/:path*",
      "destination": "/certificati/:path*",
      "permanent": true
    }
  ]
}
